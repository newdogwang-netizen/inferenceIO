#!/usr/bin/env python3
"""No-model preflight: exercise exactly the lifecycle command iorec supplies.

This is a synthetic target, not the Claude CLI and not a real-agent result.
Never print hook settings, environment, raw hook stdout/stderr or payloads.
"""
import argparse
import json
from pathlib import Path
import shlex
import subprocess
import sys


def main():
    p = argparse.ArgumentParser()
    p.add_argument("--settings", type=Path, required=True)
    args = p.parse_args()
    try:
        settings = json.loads(args.settings.read_text())
        command = settings["hooks"]["SessionStart"][0]["hooks"][0]["command"]
        result = subprocess.run(shlex.split(command), input=json.dumps({
            "hook_event_name": "SessionStart", "session_id": "iorec-install-probe", "cwd": "/app"
        }).encode(), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
        if result.returncode:
            raise RuntimeError("hook_failed")
    except Exception:
        print('{"lifecycle_probe":"failed"}')
        return 65
    print('{"lifecycle_probe":"passed"}')
    return 0


if __name__ == "__main__":
    sys.exit(main())
