# copy to deploy/.env and fill in
POSTGRES_PASSWORD=<unique-random-password>
IOREC_BOOTSTRAP_PROJECT_TOKEN=iorp_<at-least-32-random-bytes>
# Generate fresh values per deployment; never copy development or qualification tokens.
# user auth: "token" with IOREC_USER_TOKENS="tok1=alice@example.com:admin,tok2=bob@example.com:viewer"
# or "oidc" with IOREC_OIDC_ISSUER / IOREC_OIDC_CLIENT_ID
IOREC_AUTH_MODE=token
IOREC_USER_TOKENS=
IOREC_BIND_ADDR=127.0.0.1
IOREC_HTTP_PORT=8088
# Keep the built-in HTTP listener on loopback. Production remote access must use
# a TLS/OIDC-aware ingress that revalidates issuer, audience and signature.
# Per-API-replica authenticated project request bucket. Multi-replica
# deployments must also enforce a shared limit at the ingress layer.
IOREC_PROJECT_REQUESTS_PER_MINUTE=6000
IOREC_PROJECT_REQUEST_BURST=200
IOREC_PROJECT_STORAGE_BYTES=107374182400
